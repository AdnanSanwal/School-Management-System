{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=backend"
      ],
      "port": 5000,
      "env": {
        "PAYMENT_GATEWAY": "test"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=frontend"
      ],
      "port": 3000
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=backend"
      ],
      "port": 5001,
      "env": {
        "PORT": "5001",
        "PAYMENT_GATEWAY": "test",
        "JOBS_ENABLED": "false"
      }
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=frontend",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:5001/api/v1",
        "API_PROXY_URL": "http://localhost:5001/api",
        "NEXT_DIST_DIR": ".next-dev"
      }
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "mobile",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
