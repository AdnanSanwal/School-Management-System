# Production settings for docker-compose.prod.yml.
#   cp .env.production.example .env.production   then fill in every "change-me".
# Generate secrets with:   openssl rand -hex 32
# Never commit .env.production.

# ─── Site ────────────────────────────────────────────────────────────────────
# The domain whose DNS A record points at this server. Caddy gets the HTTPS
# certificate for it automatically. Use "localhost" to try the stack locally.
DOMAIN=erp.example.com
TZ=Asia/Karachi

# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# MySQL memory cache: ~512M on a 2 GB server, 1G on 4 GB
MYSQL_BUFFER_POOL=512M

# ─── Secrets (openssl rand -hex 32) ──────────────────────────────────────────
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
# Exactly 64 hex characters. Keep it forever: data encrypted with it can't be read without it.
AES_SECRET_KEY=change-me
FILE_URL_SECRET=change-me

# ─── Daily jobs (late fines, reminders, attendance alerts) ───────────────────
JOBS_ENABLED=true
JOBS_RUN_HOUR=7

# ─── Online fee payments ─────────────────────────────────────────────────────
# Leave empty to accept only bank-transfer / JazzCash / Easypaisa proof uploads.
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_SECRET=

# ─── WhatsApp / SMS (each school switches it on in School settings) ──────────
# twilio | test | empty (off)
MESSAGING_PROVIDER=
DEFAULT_COUNTRY_CODE=92
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ─── Web push (npx web-push generate-vapid-keys) ─────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Email (optional) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=

# ─── Backups ─────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# Speed / diagnostics
# Password hashing cost (10 = fast logins, the common default; higher is slower)
BCRYPT_ROUNDS=10
# Log a warning for any API request slower than this
SLOW_REQUEST_MS=500

# ─── Capacity and resilience ────────────────────────────────────────────────
# Backend worker processes ("auto" = one per CPU core). Each needs DB_POOL MySQL connections.
WEB_CONCURRENCY=2
DB_POOL=10
# How long a stopping server waits for in-flight requests
SHUTDOWN_TIMEOUT_MS=15000
# Sign-in token lifetime; the apps renew it silently. Shorter = a leaked token dies sooner.
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
# Protects /metrics (Prometheus) with "Authorization: Bearer <token>"
METRICS_TOKEN=

# Optional: your OWN Sentry project for error reports (both empty = off)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Expo web build origin, if you host the parent app on the web
MOBILE_ORIGIN=
