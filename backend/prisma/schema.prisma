// ─── Finance: where the school's money sits and what moves through it ───

// Cash in hand, a bank account, or a mobile wallet. Fee payments land in the account
// whose `methods` include the payment method.
model MoneyAccount {
  id             String           @id @default(uuid())
  schoolId       String
  name           String           @db.VarChar(80)
  type           MoneyAccountType @default(CASH)
  accountNo      String?          @db.VarChar(40)
  methods        Json // PaymentMethod[] this account receives, e.g. ["CASH"]
  openingBalance Decimal          @default(0) @db.Decimal(14, 2)
  openingDate    DateTime         @db.Date
  notes          String?          @db.VarChar(300)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())

  payments     Payment[]
  transactions MoneyTransaction[]
  expenses     Expense[]
  incomes      OtherIncome[]
  loans        StaffLoan[]
  repayments   LoanRepayment[]

  @@unique([schoolId, name])
  @@map("money_accounts")
}

// Money moved by hand: deposits, withdrawals, corrections and transfers between accounts.
model MoneyTransaction {
  id          String               @id @default(uuid())
  schoolId    String
  accountId   String
  type        MoneyTransactionType
  amount      Decimal              @db.Decimal(14, 2)
  txDate      DateTime             @db.Date
  description String?              @db.VarChar(300)
  reference   String?              @db.VarChar(100)
  transferId  String? // the two halves of a transfer share this id
  createdById String?
  createdAt   DateTime             @default(now())

  account MoneyAccount @relation(fields: [accountId], references: [id])

  @@index([schoolId, txDate])
  @@index([accountId, txDate])
  @@map("money_transactions")
}

// Expense and other-income headings ("Rent", "Utilities" / "Canteen rent", "Donations").
model FinanceCategory {
  id        String              @id @default(uuid())
  schoolId  String
  kind      FinanceCategoryKind
  name      String              @db.VarChar(60)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())

  expenses Expense[]
  incomes  OtherIncome[]

  @@unique([schoolId, kind, name])
  @@map("finance_categories")
}

// Money the school spent. Only APPROVED expenses reduce the account; large ones wait
// for the owner (School.expenseApprovalLimit).
model Expense {
  id            String         @id @default(uuid())
  schoolId      String
  expenseNo     String
  categoryId    String
  accountId     String
  amount        Decimal        @db.Decimal(14, 2)
  expenseDate   DateTime       @db.Date
  paidTo        String?        @db.VarChar(120)
  description   String         @db.VarChar(500)
  reference     String?        @db.VarChar(100)
  receiptKey    String?        @db.VarChar(512) // uploaded bill/receipt (see src/utils/storage.ts)
  status        ApprovalStatus @default(APPROVED)
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?        @db.VarChar(300)
  // Set on the expense a paid payroll run creates; such an expense can't be deleted by hand.
  payrollRunId  String?        @unique
  createdAt     DateTime       @default(now())

  category FinanceCategory @relation(fields: [categoryId], references: [id])
  account  MoneyAccount    @relation(fields: [accountId], references: [id])

  @@unique([schoolId, expenseNo])
  @@index([schoolId, expenseDate])
  @@index([accountId])
  @@map("expenses")
}

// Money received that is not a student fee: canteen rent, uniform sales, donations.
model OtherIncome {
  id           String   @id @default(uuid())
  schoolId     String
  incomeNo     String
  categoryId   String
  accountId    String
  amount       Decimal  @db.Decimal(14, 2)
  incomeDate   DateTime @db.Date
  receivedFrom String?  @db.VarChar(120)
  description  String   @db.VarChar(500)
  reference    String?  @db.VarChar(100)
  createdById  String?
  createdAt    DateTime @default(now())

  category FinanceCategory @relation(fields: [categoryId], references: [id])
  account  MoneyAccount    @relation(fields: [accountId], references: [id])

  @@unique([schoolId, incomeNo])
  @@index([schoolId, incomeDate])
  @@index([accountId])
  @@map("other_incomes")
}

// A school's own change to what a role may do: a permission added to, or taken from,
// the role's standard set (see src/middleware/rbac.ts). Roles without rows use the standard set.
model RolePermission {
  id         String   @id @default(uuid())
  schoolId   String
  role       Role
  permission String   @db.VarChar(60)
  granted    Boolean
  createdAt  DateTime @default(now())

  @@unique([schoolId, role, permission])
  @@map("role_permissions")
}

// ─── Accounting ledger ───
// The ledger is worked out from the records themselves (fee payments, expenses, income,
// payroll, advances, transfers), so it can never disagree with them. Only the chart of
// accounts and hand-made journal entries are stored.

model LedgerAccount {
  id             String            @id @default(uuid())
  schoolId       String
  code           String            @db.VarChar(10)
  name           String            @db.VarChar(100)
  type           LedgerAccountType
  // Built-in accounts: FEE_INCOME, STAFF_ADVANCES, OPENING_EQUITY, OWNER, ADJUSTMENT_GAIN, ADJUSTMENT_LOSS.
  systemKey      String?           @db.VarChar(30)
  // An account that mirrors a money account or an expense / income category follows its name.
  moneyAccountId String?           @unique
  categoryId     String?           @unique
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  lines JournalLine[]

  @@unique([schoolId, code])
  @@unique([schoolId, systemKey])
  @@map("ledger_accounts")
}

// A journal entry made by hand (everything else posts itself).
model JournalEntry {
  id          String   @id @default(uuid())
  schoolId    String
  entryNo     String
  date        DateTime @db.Date
  description String   @db.VarChar(300)
  reference   String?  @db.VarChar(100)
  createdById String?
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@unique([schoolId, entryNo])
  @@index([schoolId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid())
  schoolId       String
  entryId        String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  // Copied from the entry / account so balances can be summed without joins.
  date           DateTime @db.Date
  moneyAccountId String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([schoolId, date])
  @@index([accountId])
  @@index([moneyAccountId])
  @@map("journal_lines")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// ─── Payroll ───

// One month's salaries. DRAFT (accountant prepares and reviews) → SUBMITTED (waits for the
// owner) → APPROVED → PAID (money leaves an account as a "Salaries" expense).
model PayrollRun {
  id           String        @id @default(uuid())
  schoolId     String
  period       String        @db.VarChar(7) // "2026-11"
  status       PayrollStatus @default(DRAFT)
  note         String?       @db.VarChar(300)
  createdById  String?
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?       @db.VarChar(300)
  paidById     String?
  paidAt       DateTime?
  paymentDate  DateTime?     @db.Date
  accountId    String? // the account the salaries were paid from
  createdAt    DateTime      @default(now())

  lines PayrollLine[]

  @@unique([schoolId, period])
  @@map("payroll_runs")
}

// One person's pay for the month. Pay details are copied in, so a payslip never changes
// when the salary structure or the staff record is edited later.
model PayrollLine {
  id               String  @id @default(uuid())
  schoolId         String
  runId            String
  staffId          String
  name             String
  employeeNo       String
  designation      String?
  department       String?
  bankName         String? @db.VarChar(100)
  bankAccountTitle String? @db.VarChar(100)
  bankAccountNo    String? @db.VarChar(40)

  basic           Decimal @db.Decimal(12, 2)
  allowances      Json // [{ name, amount }]
  fixedDeductions Json // [{ name, amount }] tax, EOBI...
  gross           Decimal @db.Decimal(12, 2) // basic + allowances

  daysInMonth      Int
  absentDays       Decimal @default(0) @db.Decimal(4, 1) // from staff attendance (half day = 0.5)
  unpaidLeaveDays  Decimal @default(0) @db.Decimal(4, 1) // approved leave that is not paid
  notEmployedDays  Decimal @default(0) @db.Decimal(4, 1) // before joining / after leaving
  // Days of pay actually deducted. Starts as the sum of the three above; the accountant may change it.
  deductDays       Decimal @default(0) @db.Decimal(4, 1)
  deductDaysManual Boolean @default(false)
  absenceDeduction Decimal @default(0) @db.Decimal(12, 2)

  loanDeduction   Decimal @default(0) @db.Decimal(12, 2)
  loanManual      Boolean @default(false)
  bonus           Decimal @default(0) @db.Decimal(12, 2)
  otherDeduction  Decimal @default(0) @db.Decimal(12, 2)
  remarks         String? @db.VarChar(300)
  totalDeductions Decimal @db.Decimal(12, 2)
  net             Decimal @db.Decimal(12, 2)

  run        PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  staff      Staff           @relation(fields: [staffId], references: [id])
  repayments LoanRepayment[]

  @@unique([runId, staffId])
  @@index([schoolId])
  @@index([staffId])
  @@map("payroll_lines")
}

// Money given to a staff member ahead of salary: a one-off advance or a loan repaid in
// monthly instalments. Recovered through payroll or paid back in cash.
model StaffLoan {
  id          String     @id @default(uuid())
  schoolId    String
  loanNo      String
  staffId     String
  kind        LoanKind   @default(ADVANCE)
  amount      Decimal    @db.Decimal(12, 2)
  issuedOn    DateTime   @db.Date
  accountId   String // paid out of this account
  installment Decimal    @db.Decimal(12, 2) // recovered from each salary
  startPeriod String     @db.VarChar(7) // first payroll month that recovers it
  note        String?    @db.VarChar(300)
  status      LoanStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime   @default(now())

  staff      Staff           @relation(fields: [staffId], references: [id])
  account    MoneyAccount    @relation(fields: [accountId], references: [id])
  repayments LoanRepayment[]

  @@unique([schoolId, loanNo])
  @@index([staffId])
  @@index([accountId])
  @@map("staff_loans")
}

model LoanRepayment {
  id            String   @id @default(uuid())
  schoolId      String
  loanId        String
  amount        Decimal  @db.Decimal(12, 2)
  paidOn        DateTime @db.Date
  payrollLineId String? // recovered from this payslip
  accountId     String? // or paid back in cash into this account
  note          String?  @db.VarChar(300)
  createdAt     DateTime @default(now())

  loan        StaffLoan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollLine PayrollLine?  @relation(fields: [payrollLineId], references: [id])
  account     MoneyAccount? @relation(fields: [accountId], references: [id])

  @@index([loanId])
  @@index([accountId])
  @@index([payrollLineId])
  @@map("loan_repayments")
}

enum PayrollStatus {
