// School ERP — multi-school (SaaS) schema.
//
// Tenancy rule: every model except `School` carries `schoolId`. The scoped
// Prisma client in src/config/database.ts injects/filters `schoolId`
// automatically for top-level queries, so always write `schoolId` as a scalar
// (never `school: { connect }`) and never rely on nested writes to set it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model School {
  id                     String           @id @default(uuid())
  name                   String
  code                   String           @unique // short slug, e.g. "greenfield"
  address                String?          @db.Text
  phone                  String?
  email                  String?
  logoUrl                String?          @db.VarChar(1024)
  currency               String           @default("PKR")
  timezone               String           @default("Asia/Karachi")
  isActive               Boolean          @default(true)
  // Late fee: a one-time fine added to an invoice this many days after its due date (0 = off).
  lateFeeAmount          Decimal          @default(0) @db.Decimal(12, 2)
  lateFeeGraceDays       Int              @default(7)
  // Monthly attendance % below which parents and the principal are alerted.
  lowAttendanceThreshold Int              @default(75)
  // Library late fine per day (0 = no fines).
  libraryFinePerDay      Decimal          @default(0) @db.Decimal(12, 2)
  // Expenses above this amount wait for the owner's approval (null = no approval needed).
  expenseApprovalLimit   Decimal?         @db.Decimal(12, 2)
  // Accounting: nothing dated in or before this month ("2026-10") can be added, changed or removed.
  booksClosedThrough     String?          @db.VarChar(7)
  // WhatsApp/SMS alerts to guardians' phones (see utils/messaging.ts).
  messagingEnabled       Boolean          @default(false)
  messagingChannel       MessagingChannel @default(SMS)
  messagingTypes         Json? // notification types also sent by SMS/WhatsApp, e.g. ["ATTENDANCE_ABSENT"]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  academicYears AcademicYear[]
  users         User[]

  @@map("schools")
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // "2026-27"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school          School              @relation(fields: [schoolId], references: [id])
  subjectTeachers SubjectAssignment[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  feeInvoices     FeeInvoice[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

// Per-school sequences (receipt numbers, invoice numbers, admission numbers).
model Counter {
  schoolId String
  key      String
  value    Int    @default(0)

  @@id([schoolId, key])
  @@map("counters")
}

// ─── People ──────────────────────────────────────────────────────────────────

model User {
  id                 String         @id @default(uuid())
  schoolId           String? // null only for SUPER_ADMIN (platform operator)
  name               String
  // Optional for staff created with a username (CR-05). Unique when present.
  email              String?        @unique
  // Sign-in name chosen by the admin (lowercase, unique on the platform). Optional for
  // accounts that sign in with email.
  username           String?        @unique @db.VarChar(60)
  phone              String?        @db.VarChar(32)
  password           String
  // Set when an admin chose the password; the user must pick their own at next sign-in.
  mustChangePassword Boolean        @default(false)
  role               Role
  isActive           Boolean        @default(true)
  avatar             String?        @db.VarChar(1024)
  mfaEnabled         Boolean        @default(false)
  mfaSecret          String?        @db.Text
  resetToken         String?
  resetTokenExpires  DateTime?
  oauthProvider      OAuthProvider?
  oauthId            String?
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  school            School?            @relation(fields: [schoolId], references: [id])
  staff             Staff?
  guardian          Guardian?
  student           Student?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  noticeReads       NoticeRead[]

  @@index([schoolId, role])
  @@map("users")
}

model Staff {
  id                    String       @id @default(uuid())
  schoolId              String
  userId                String?      @unique // non-teaching staff may have no login
  employeeNo            String
  name                  String
  phone                 String?      @db.VarChar(32)
  designation           String? // "Teacher", "Clerk", "Driver"...
  department            String?
  qualification         String?
  joiningDate           DateTime?    @db.Date
  isTeacher             Boolean      @default(true)
  status                StaffStatus  @default(ACTIVE)
  // ── HR profile ──
  cnic                  String?      @db.VarChar(20)
  dateOfBirth           DateTime?    @db.Date
  gender                Gender?
  email                 String?      @db.VarChar(191) // contact email (the login is on User)
  address               String?      @db.Text
  emergencyContactName  String?      @db.VarChar(100)
  emergencyContactPhone String?      @db.VarChar(32)
  contractType          ContractType @default(PERMANENT)
  // Where salary is paid; shown on the bank transfer sheet.
  bankName              String?      @db.VarChar(100)
  bankAccountTitle      String?      @db.VarChar(100)
  bankAccountNo         String?      @db.VarChar(40) // account number or IBAN
  leftOn                DateTime?    @db.Date
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user             User?               @relation(fields: [userId], references: [id])
  documents        StaffDocument[]
  salaryStructures SalaryStructure[]
  classTeacherOf   Section[]
  subjectsTaught   SubjectAssignment[]
  timetable        TimetableSlot[]
  attendance       StaffAttendance[]
  leaveRequests    LeaveRequest[]
  payrollLines     PayrollLine[]
  loans            StaffLoan[]
  diaryEntries     DiaryEntry[]

  @@unique([schoolId, employeeNo])
  @@index([schoolId])
  @@map("staff")
}

// Uploaded staff papers: CNIC copy, degree, contract, experience letters.
model StaffDocument {
  id         String   @id @default(uuid())
  schoolId   String
  staffId    String
  title      String
  storageKey String   @db.VarChar(512) // uploaded file (see src/utils/storage.ts)
  fileName   String?
  mimeType   String?  @db.VarChar(100)
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([staffId])
  @@map("staff_documents")
}

// Managed lists for the staff forms. Staff keep the chosen name as text, so renaming
// an entry here also renames it on staff (done in the HR routes).
model Department {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@map("departments")
}

model Designation {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@map("designations")
}

// A person's pay from a date onwards. A raise is a new row with a later effectiveFrom,
// so the history is kept and payroll for an old month still uses that month's pay.
model SalaryStructure {
  id            String   @id @default(uuid())
  schoolId      String
  staffId       String
  effectiveFrom DateTime @db.Date
  basic         Decimal  @db.Decimal(12, 2)
  note          String?  @db.VarChar(300)
  createdById   String?
  createdAt     DateTime @default(now())

  staff      Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@unique([staffId, effectiveFrom])
  @@index([schoolId])
  @@map("salary_structures")
}

// Monthly allowances (house rent, transport…) and fixed deductions (income tax, EOBI…).
model SalaryComponent {
  id          String              @id @default(uuid())
  schoolId    String
  structureId String
  kind        SalaryComponentKind
  name        String              @db.VarChar(60)
  amount      Decimal             @db.Decimal(12, 2)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([structureId])
  @@map("salary_components")
}

// Yearly leave allowance per type. Approved days beyond it are unpaid (deducted in payroll).
model LeavePolicy {
  id          String    @id @default(uuid())
  schoolId    String
  type        LeaveType
  daysPerYear Int       @default(0)
  // false = every day of this type is unpaid (e.g. "Unpaid leave").
  isPaid      Boolean   @default(true)

  @@unique([schoolId, type])
  @@map("leave_policies")
}

model Guardian {
  id         String   @id @default(uuid())
  schoolId   String
  userId     String?  @unique // set once the parent gets app access
  name       String
  phone      String   @db.VarChar(32)
  email      String?
  cnic       String?  @db.VarChar(32)
  occupation String?
  address    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
  @@index([schoolId, phone])
  @@map("guardians")
}

model Student {
  id            String        @id @default(uuid())
  schoolId      String
  userId        String?       @unique // optional student app login
  admissionNo   String
  rollNo        String?
  name          String
  gender        Gender?
  dateOfBirth   DateTime?     @db.Date
  bloodGroup    String?       @db.VarChar(8)
  address       String?       @db.Text
  photoUrl      String?       @db.VarChar(1024)
  photoKey      String?       @db.VarChar(512) // uploaded photo; served via signed URL
  admissionDate DateTime      @db.Date
  sectionId     String?
  // The student's own monthly fee, set at admission (CR-04). When present it replaces the
  // class's monthly fee heads on monthly invoices; null = bill from the class fee structure.
  monthlyFee    Decimal?      @db.Decimal(12, 2)
  status        StudentStatus @default(ACTIVE)
  leftOn        DateTime?     @db.Date
  leftReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user           User?               @relation(fields: [userId], references: [id])
  section        Section?            @relation(fields: [sectionId], references: [id])
  guardians      StudentGuardian[]
  documents      StudentDocument[]
  attendance     StudentAttendance[]
  marks          Mark[]
  examRemarks    ExamRemark[]
  concessions    Concession[]
  invoices       FeeInvoice[]
  payments       Payment[]
  paymentClaims  PaymentClaim[]
  paymentIntents PaymentIntent[]
  promotions     PromotionRecord[]
  transport      StudentTransport?
  bookIssues     BookIssue[]
  homework       HomeworkStatus[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([sectionId])
  @@map("students")
}

// Many-to-many: siblings share a guardian; a child can have several guardians.
model StudentGuardian {
  schoolId   String
  studentId  String
  guardianId String
  relation   GuardianRelation @default(FATHER)
  isPrimary  Boolean          @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
  @@map("student_guardians")
}

model StudentDocument {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  title      String
  url        String?  @db.VarChar(1024) // external link, or
  storageKey String?  @db.VarChar(512) // uploaded file (see src/utils/storage.ts)
  fileName   String?
  mimeType   String?  @db.VarChar(100)
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("student_documents")
}

// ─── Academic structure ──────────────────────────────────────────────────────

model Class {
  id         String    @id @default(uuid())
  schoolId   String
  name       String // "Class 8", "Nursery"
  level      Int // ordering + promotion (Nursery=0, Class 1=1 ...)
  // Archived classes are hidden everywhere but keep their history; they can be restored.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  sections      Section[]
  examSubjects  ExamSubject[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid())
  schoolId       String
  classId        String
  name           String // "A"
  classTeacherId String?
  capacity       Int?
  createdAt      DateTime @default(now())

  class           Class               @relation(fields: [classId], references: [id])
  classTeacher    Staff?              @relation(fields: [classTeacherId], references: [id])
  students        Student[]
  subjectTeachers SubjectAssignment[]
  timetable       TimetableSlot[]
  attendance      StudentAttendance[]
  diaryEntries    DiaryEntry[]
  noticeTargets   NoticeTarget[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  code      String
  createdAt DateTime @default(now())

  teachers     SubjectAssignment[]
  timetable    TimetableSlot[]
  examSubjects ExamSubject[]
  diaryEntries DiaryEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

// Which teacher teaches which subject to which section in a given year.
model SubjectAssignment {
  id             String @id @default(uuid())
  schoolId       String
  academicYearId String
  sectionId      String
  subjectId      String
  teacherId      String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Staff        @relation(fields: [teacherId], references: [id])

  @@unique([academicYearId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("subject_assignments")
}

model TimetableSlot {
  id        String    @id @default(uuid())
  schoolId  String
  sectionId String
  subjectId String
  teacherId String
  dayOfWeek DayOfWeek
  period    Int
  startTime String    @db.VarChar(5) // "08:00"
  endTime   String    @db.VarChar(5)
  room      String?

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Staff   @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, dayOfWeek, period])
  @@index([schoolId])
  @@index([teacherId, dayOfWeek])
  @@map("timetable_slots")
}

// ─── Attendance & leave ──────────────────────────────────────────────────────

model StudentAttendance {
  id         String           @id @default(uuid())
  schoolId   String
  studentId  String
  sectionId  String
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([sectionId, date])
  @@map("student_attendance")
}

model StaffAttendance {
  id         String           @id @default(uuid())
  schoolId   String
  staffId    String
  date       DateTime         @db.Date
  status     AttendanceStatus
  checkIn    DateTime?
  checkOut   DateTime?
  remarks    String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([schoolId, date])
  @@map("staff_attendance")
}

model LeaveRequest {
  id           String         @id @default(uuid())
  schoolId     String
  staffId      String
  type         LeaveType      @default(CASUAL)
  fromDate     DateTime       @db.Date
  toDate       DateTime       @db.Date
  reason       String         @db.Text
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([staffId])
  @@map("leave_requests")
}

// ─── Exams ───────────────────────────────────────────────────────────────────

model Exam {
  id             String     @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String // "Mid Term"
  startDate      DateTime?  @db.Date
  endDate        DateTime?  @db.Date
  status         ExamStatus @default(DRAFT)
  approvedById   String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  subjects     ExamSubject[]
  remarks      ExamRemark[]

  @@index([schoolId])
  @@map("exams")
}

model ExamSubject {
  id           String    @id @default(uuid())
  schoolId     String
  examId       String
  classId      String
  subjectId    String
  date         DateTime? @db.Date
  totalMarks   Decimal   @db.Decimal(6, 2)
  passingMarks Decimal   @db.Decimal(6, 2)
  syllabus     String?   @db.Text

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  marks   Mark[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId])
  @@map("exam_subjects")
}

model Mark {
  id            String   @id @default(uuid())
  schoolId      String
  examSubjectId String
  studentId     String
  obtained      Decimal? @db.Decimal(6, 2)
  isAbsent      Boolean  @default(false)
  remarks       String?
  enteredById   String?
  updatedAt     DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("marks")
}

// Class teacher's overall remark on a student's report card.
model ExamRemark {
  id          String   @id @default(uuid())
  schoolId    String
  examId      String
  studentId   String
  remarks     String   @db.Text
  enteredById String?
  updatedAt   DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([schoolId])
  @@map("exam_remarks")
}

model GradeScale {
  id         String  @id @default(uuid())
  schoolId   String
  grade      String  @db.VarChar(8) // "A+"
  minPercent Decimal @db.Decimal(5, 2)
  maxPercent Decimal @db.Decimal(5, 2)
  remark     String?

  @@unique([schoolId, grade])
  @@index([schoolId])
  @@map("grade_scales")
}

// ─── Daily diary / homework ──────────────────────────────────────────────────

model DiaryEntry {
  id         String    @id @default(uuid())
  schoolId   String
  sectionId  String
  subjectId  String?
  teacherId  String
  date       DateTime  @db.Date
  title      String?
  content    String    @db.Text
  isHomework Boolean   @default(false)
  dueDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())

  section     Section           @relation(fields: [sectionId], references: [id])
  subject     Subject?          @relation(fields: [subjectId], references: [id])
  teacher     Staff             @relation(fields: [teacherId], references: [id])
  attachments DiaryAttachment[]
  completions HomeworkStatus[]

  @@index([schoolId])
  @@index([sectionId, date])
  @@map("diary_entries")
}

model DiaryAttachment {
  id           String @id @default(uuid())
  schoolId     String
  diaryEntryId String
  url          String @db.VarChar(1024)
  fileName     String
  mimeType     String

  diaryEntry DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("diary_attachments")
}

// ─── Calendar & notices ──────────────────────────────────────────────────────

model CalendarEvent {
  id          String            @id @default(uuid())
  schoolId    String
  title       String
  description String?           @db.Text
  type        CalendarEventType @default(EVENT)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([schoolId, startDate])
  @@map("calendar_events")
}

model Notice {
  id            String         @id @default(uuid())
  schoolId      String
  title         String
  body          String         @db.Text
  audience      NoticeAudience @default(ALL)
  attachmentUrl String?        @db.VarChar(1024)
  createdById   String
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())

  targets NoticeTarget[] // only used when audience = SECTIONS
  reads   NoticeRead[]

  @@index([schoolId, publishedAt])
  @@map("notices")
}

model NoticeTarget {
  schoolId  String
  noticeId  String
  sectionId String

  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([noticeId, sectionId])
  @@index([schoolId])
  @@map("notice_targets")
}

model NoticeRead {
  schoolId String
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([schoolId])
  @@map("notice_reads")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model FeeHead {
  id        String       @id @default(uuid())
  schoolId  String
  name      String // "Tuition", "Transport", "Lab"
  frequency FeeFrequency @default(MONTHLY)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  structures   FeeStructure[]
  invoiceItems FeeInvoiceItem[]
  concessions  Concession[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_heads")
}

// Class-wise amount per fee head for an academic year.
model FeeStructure {
  id             String  @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  feeHeadId      String
  amount         Decimal @db.Decimal(12, 2)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@unique([academicYearId, classId, feeHeadId])
  @@index([schoolId])
  @@map("fee_structures")
}

model Concession {
  id            String         @id @default(uuid())
  schoolId      String
  studentId     String
  feeHeadId     String? // null = applies to all heads
  type          ConcessionType
  value         Decimal        @db.Decimal(12, 2) // percent or fixed amount
  reason        String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  validFrom     DateTime       @db.Date
  validTo       DateTime?      @db.Date
  createdAt     DateTime       @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead? @relation(fields: [feeHeadId], references: [id])

  @@index([schoolId, status])
  @@index([studentId])
  @@map("concessions")
}

// One voucher per student per billing period ("2026-04").
model FeeInvoice {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  invoiceNo      String
  period         String        @db.VarChar(7)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  grossAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  fineAmount     Decimal       @default(0) @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  fineAppliedAt  DateTime?
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student      Student             @relation(fields: [studentId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  items        FeeInvoiceItem[]
  allocations  PaymentAllocation[]

  @@unique([schoolId, invoiceNo])
  @@unique([studentId, period])
  @@index([schoolId, status, dueDate])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id        String  @id @default(uuid())
  schoolId  String
  invoiceId String
  feeHeadId String
  amount    Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@index([schoolId])
  @@map("fee_invoice_items")
}

// A successful payment is the receipt (receiptNo is sequential per school).
model Payment {
  id            String        @id @default(uuid())
  schoolId      String
  studentId     String
  receiptNo     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(SUCCESS)
  reference     String? // bank/JazzCash/Easypaisa transaction id
  gatewayData   Json?
  paidAt        DateTime      @default(now())
  collectedById String?
  remarks       String?
  // Which cash/bank/wallet account received the money (set from the payment method).
  accountId     String?

  student     Student             @relation(fields: [studentId], references: [id])
  account     MoneyAccount?       @relation(fields: [accountId], references: [id])
  allocations PaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paidAt])
  @@index([studentId])
  @@index([accountId])
  @@map("payments")
}

// One payment can settle several monthly invoices.
model PaymentAllocation {
  schoolId  String
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(12, 2)

  payment Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@id([paymentId, invoiceId])
  @@index([schoolId])
  @@map("payment_allocations")
}

// Where parents can send fee money (shown in the app's "Pay online").
model PaymentAccount {
  id        String        @id @default(uuid())
  schoolId  String
  method    PaymentMethod // JAZZCASH / EASYPAISA / BANK_TRANSFER
  title     String // "Greenfield School"
  accountNo String
  bankName  String?
  iban      String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([schoolId])
  @@map("payment_accounts")
}

// Parent says "I paid": transaction id + screenshot, verified by the accountant.
model PaymentClaim {
  id            String         @id @default(uuid())
  schoolId      String
  studentId     String
  invoiceIds    Json // string[]
  amount        Decimal        @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String
  proofKey      String?        @db.VarChar(512)
  note          String?
  status        ApprovalStatus @default(PENDING)
  submittedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  paymentId     String?        @unique
  createdAt     DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, method, reference])
  @@index([schoolId, status])
  @@map("payment_claims")
}

// Online checkout through a payment gateway (see modules/payments/gateways).
model PaymentIntent {
  id          String              @id @default(uuid())
  schoolId    String
  studentId   String
  invoiceIds  Json // string[]
  amount      Decimal             @db.Decimal(12, 2)
  provider    String              @db.VarChar(20)
  status      PaymentIntentStatus @default(CREATED)
  providerRef String?
  createdById String
  paymentId   String?             @unique
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("payment_intents")
}

// ─── Year-end promotion ───

// One row per student per promotion run: where they were and what happened.
model PromotionRecord {
  id                 String           @id @default(uuid())
  schoolId           String
  studentId          String
  fromAcademicYearId String
  toAcademicYearId   String
  fromSectionId      String?
  toSectionId        String?
  outcome            PromotionOutcome
  createdById        String
  createdAt          DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, toAcademicYearId])
  @@index([schoolId, toAcademicYearId])
  @@map("promotion_records")
}

// ─── Transport ───

model TransportRoute {
  id          String   @id @default(uuid())
  schoolId    String
  name        String // "Route 1 — Model Town"
  vehicleNo   String?
  driverName  String?
  driverPhone String?  @db.VarChar(32)
  capacity    Int?
  monthlyFee  Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  stops    TransportStop[]
  students StudentTransport[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("transport_routes")
}

model TransportStop {
  id         String  @id @default(uuid())
  schoolId   String
  routeId    String
  name       String
  pickupTime String? @db.VarChar(5) // "07:10"
  dropTime   String? @db.VarChar(5)
  sortOrder  Int     @default(0)

  route    TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students StudentTransport[]

  @@index([schoolId])
  @@index([routeId])
  @@map("transport_stops")
}

model StudentTransport {
  id        String   @id @default(uuid())
  schoolId  String
  studentId String   @unique
  routeId   String
  stopId    String?
  since     DateTime @db.Date

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id])
  stop    TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([routeId])
  @@map("student_transport")
}

// ─── Library ───

model Book {
  id        String   @id @default(uuid())
  schoolId  String
  title     String
  author    String?
  isbn      String?  @db.VarChar(20)
  category  String?
  shelf     String?
  copies    Int      @default(1)
  createdAt DateTime @default(now())

  issues BookIssue[]

  @@index([schoolId])
  @@index([schoolId, title])
  @@map("books")
}

model BookIssue {
  id         String    @id @default(uuid())
  schoolId   String
  bookId     String
  studentId  String
  issuedAt   DateTime  @db.Date
  dueDate    DateTime  @db.Date
  returnedAt DateTime? @db.Date
  fine       Decimal   @default(0) @db.Decimal(12, 2)
  finePaid   Boolean   @default(false)
  issuedById String

  book    Book    @relation(fields: [bookId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, returnedAt])
  @@index([bookId])
  @@index([studentId])
  @@map("book_issues")
}

// ─── Homework tracking ───

model HomeworkStatus {
  id           String   @id @default(uuid())
  schoolId     String
  diaryEntryId String
  studentId    String
  markedById   String
  markedAt     DateTime @default(now())

  diaryEntry DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([diaryEntryId, studentId])
  @@index([schoolId])
  @@map("homework_status")
}

// ─── WhatsApp / SMS log ───

model OutboundMessage {
  id          String           @id @default(uuid())
  schoolId    String
  type        String
  channel     MessagingChannel
  to          String           @db.VarChar(32)
  body        String           @db.Text
  provider    String           @db.VarChar(20)
  status      MessageStatus    @default(QUEUED)
  providerRef String?
  error       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([schoolId, createdAt])
  @@map("outbound_messages")
}

// ─── Notifications & audit ───────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  schoolId  String
  userId    String
  type      String // "ATTENDANCE_ABSENT", "FEE_DUE", "DIARY_POSTED"...
  title     String
  body      String    @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Web push (browser)
model PushSubscription {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.VarChar(1024)
  auth      String   @db.VarChar(1024)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("push_subscriptions")
}

// Mobile push (Expo)
model DeviceToken {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(16)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("device_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

