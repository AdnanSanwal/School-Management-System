  SUPER_ADMIN
  OWNER
  PRINCIPAL
  ADMIN
  ACCOUNTANT
  TEACHER
  PARENT
  STUDENT
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  LEFT
  TRANSFERRED
  GRADUATED
}

enum StaffStatus {
  ACTIVE
  LEFT
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  OTHER
