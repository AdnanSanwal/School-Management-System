# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Public URL of this API — used in signed file links and payment-gateway callbacks
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:your_password@localhost:3306/school_db"
REDIS_URL="redis://localhost:6379"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Encryption (AES-256-GCM for PII fields) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=your_64_hex_char_aes_key_here

# ─── OAuth 2.0 ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

MS_CLIENT_ID=your_microsoft_azure_app_client_id
MS_CLIENT_SECRET=your_microsoft_azure_app_client_secret
MS_TENANT_ID=common

# ─── Email: any SMTP server, or a SendGrid API key ───────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SENDGRID_API_KEY=SG.xxxxxxxxx
EMAIL_FROM=noreply@yourschool.com

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourschool.com

# ─── MFA ──────────────────────────────────────────────────────────────────────
MFA_ISSUER=SchoolManagementSystem

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Your own Sentry project; leave empty to turn error reporting off
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Mobile / CORS ────────────────────────────────────────────────────────────
MOBILE_ORIGIN=exp://localhost:8081

# ─── ERP v2: uploads, payments, automation ───────────────────────────────────
# Uploaded files (student documents, photos, diary attachments). Local folder until S3 is wired.
UPLOAD_DIR=
# Secret for signed file / report-card links (defaults to JWT_SECRET)
FILE_URL_SECRET=
# Online checkout: "test" = built-in simulated gateway (never active in production).
# Leave empty to offer only "pay to school account + submit proof".
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_SECRET=
# Daily jobs (late fees daily; fee reminders + low-attendance alerts on Mondays)
JOBS_ENABLED=true
JOBS_RUN_HOUR=9
# Set true to skip Expo/Web push delivery (in-app notifications still saved)
PUSH_DISABLED=false

# ─── WhatsApp / SMS alerts to parents ────────────────────────────────────────
# twilio | test (logs only) | empty = off. Schools switch alerts on in School settings.
MESSAGING_PROVIDER=
# e.g. whatsapp:+14155238886 (Twilio WhatsApp sender)
TWILIO_WHATSAPP_FROM=
# Country code for local numbers like 0300-1234567
DEFAULT_COUNTRY_CODE=92

# ─── Behind a reverse proxy ──────────────────────────────────────────────────
# TRUST_PROXY=1
# RATE_LIMIT_MAX=1000
